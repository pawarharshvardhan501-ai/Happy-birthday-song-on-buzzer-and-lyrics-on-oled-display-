#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
#define SCREEN_ADDRESS 0x3C

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

#define BUZZER_PIN 4
#define LED_PIN 2   // onboard blue LED on most ESP32 dev boards (change if yours differs)

// ---- Notes ----
#define NOTE_C4  262
#define NOTE_D4  294
#define NOTE_E4  330
#define NOTE_F4  349
#define NOTE_G4  392
#define NOTE_A4  440
#define NOTE_AS4 466
#define NOTE_C5  523

#define Q 400
#define E 200
#define H 800

struct Note { int pitch; int duration; };

Note melody[] = {
  {NOTE_C4, E}, {NOTE_C4, E}, {NOTE_D4, Q}, {NOTE_C4, Q}, {NOTE_F4, Q}, {NOTE_E4, H},
  {NOTE_C4, E}, {NOTE_C4, E}, {NOTE_D4, Q}, {NOTE_C4, Q}, {NOTE_G4, Q}, {NOTE_F4, H},
  {NOTE_C4, E}, {NOTE_C4, E}, {NOTE_C5, Q}, {NOTE_A4, Q}, {NOTE_F4, Q}, {NOTE_E4, Q}, {NOTE_D4, H},
  {NOTE_AS4, E}, {NOTE_AS4, E}, {NOTE_A4, Q}, {NOTE_F4, Q}, {NOTE_G4, Q}, {NOTE_F4, H}
};

const char* lyricsLines[] = {
  "Happy", "Birthday", "to You!",
  "Happy", "Birthday", "to You!",
  "Happy", "Birthday", "Dear Friend!",
  "Happy", "Birthday", "to You!"
};
const int NUM_LINES = 12;
int notesPerSubline[NUM_LINES] = { 2,2,2,  2,2,2,  2,2,3,  2,2,2 };

#define LINE_HEIGHT 20
#define CENTER_Y (SCREEN_HEIGHT / 2)
#define TEXT_SIZE 2

float currentDisplayIndex = -1; // fractional, starts above screen

void drawLyricsAt(float centerPos) {
  display.clearDisplay();
  display.setTextSize(TEXT_SIZE);

  for (int i = 0; i < NUM_LINES; i++) {
    float relative = i - centerPos;
    if (relative < -1.5 || relative > 1.5) continue;

    int y = CENTER_Y + (int)round(relative * LINE_HEIGHT) - (8 * TEXT_SIZE) / 2;
    if (y < -16 || y > SCREEN_HEIGHT) continue;

    int16_t x1, y1; uint16_t w, h;
    display.getTextBounds(lyricsLines[i], 0, 0, &x1, &y1, &w, &h);
    int x = (SCREEN_WIDTH - w) / 2;

    bool isActive = fabs(relative) < 0.4;
    if (isActive) {
      display.fillRect(0, y - 2, SCREEN_WIDTH, LINE_HEIGHT, SSD1306_WHITE);
      display.setTextColor(SSD1306_BLACK);
    } else {
      display.setTextColor(SSD1306_WHITE);
    }

    display.setCursor(x, y);
    display.print(lyricsLines[i]);
  }
  display.display();
}

// Draws cake + balloons scene. balloonsPopped=true shows a "pop burst" instead of round balloons.
void drawCakeScene(bool balloonsPopped) {
  display.clearDisplay();

  // ---- Cake ----
  display.fillRect(34, 52, 60, 3, SSD1306_WHITE);       // Plate
  display.fillRect(39, 40, 50, 12, SSD1306_WHITE);      // Bottom tier
  display.fillRect(49, 30, 30, 10, SSD1306_WHITE);      // Top tier
  for (int x = 39; x < 89; x += 6) {                    // Frosting drips
    display.drawLine(x, 40, x + 3, 44, SSD1306_BLACK);
  }
  display.fillRect(62, 18, 3, 12, SSD1306_WHITE);       // Candle
  display.fillCircle(63, 14, 3, SSD1306_WHITE);         // Flame

  // ---- Balloons ----
  int leftX = 16, rightX = 112, balloonY = 18, balloonR = 9;

  if (!balloonsPopped) {
    display.fillCircle(leftX, balloonY, balloonR, SSD1306_WHITE);
    display.drawLine(leftX, balloonY + balloonR, leftX, balloonY + balloonR + 14, SSD1306_WHITE);
    display.fillCircle(rightX, balloonY, balloonR, SSD1306_WHITE);
    display.drawLine(rightX, balloonY + balloonR, rightX, balloonY + balloonR + 14, SSD1306_WHITE);
  } else {
    for (int a = 0; a < 360; a += 45) {
      float rad = a * PI / 180.0;
      int x1 = leftX + cos(rad) * 4;
      int y1 = balloonY + sin(rad) * 4;
      int x2 = leftX + cos(rad) * (balloonR + 4);
      int y2 = balloonY + sin(rad) * (balloonR + 4);
      display.drawLine(x1, y1, x2, y2, SSD1306_WHITE);

      x1 = rightX + cos(rad) * 4;
      y1 = balloonY + sin(rad) * 4;
      x2 = rightX + cos(rad) * (balloonR + 4);
      y2 = balloonY + sin(rad) * (balloonR + 4);
      display.drawLine(x1, y1, x2, y2, SSD1306_WHITE);
    }
  }

  display.display();
}

// Plays ONE note. If startsNewLine, the scroll slide happens *during* this
// note's own duration instead of adding extra delay — this removes the lag.
void playNote(int pitch, int duration, int lineIndex, bool startsNewLine) {
  unsigned long startTime = millis();
  float fromPos = currentDisplayIndex;
  float toPos = (float)lineIndex;
  unsigned long slideDuration = startsNewLine ? min((unsigned long)duration, 220UL) : 0;

  ledcWriteTone(BUZZER_PIN, pitch);
  digitalWrite(LED_PIN, HIGH); // LED on = note sounding

  if (startsNewLine) {
    while (millis() - startTime < slideDuration) {
      float progress = (float)(millis() - startTime) / (float)slideDuration;
      if (progress > 1.0) progress = 1.0;
      drawLyricsAt(fromPos + (toPos - fromPos) * progress);
      delay(15);
    }
    currentDisplayIndex = toPos;
    drawLyricsAt(currentDisplayIndex);
  }

  long remaining = (long)duration - (long)(millis() - startTime);
  if (remaining > 0) delay(remaining);

  ledcWriteTone(BUZZER_PIN, 0);
  digitalWrite(LED_PIN, LOW); // LED off = gap between notes
  delay(50);
}

void setup() {
  Wire.begin(21, 22);

  if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    for (;;);
  }

  display.clearDisplay();
  display.display();

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  ledcAttach(BUZZER_PIN, 2000, 8);
}

void loop() {
  int noteIndex = 0;
  currentDisplayIndex = -1;

  for (int line = 0; line < NUM_LINES; line++) {
    int n = notesPerSubline[line];
    for (int i = 0; i < n; i++) {
      bool first = (i == 0);
      playNote(melody[noteIndex].pitch, melody[noteIndex].duration, line, first);
      noteIndex++;
    }
  }

  // Final Cake & Balloons screen
  drawCakeScene(false);

  for (int i = 0; i < 5; i++) {
    digitalWrite(LED_PIN, HIGH);
    drawCakeScene(true);   // balloons "pop"
    delay(150);
    digitalWrite(LED_PIN, LOW);
    drawCakeScene(false);  // balloons re-appear
    delay(150);
  }
  delay(4000);
}
